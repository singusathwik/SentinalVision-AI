SENTINEL_SECRET=replace-with-a-random-secret-at-least-32-characters
SENTINEL_DATABASE_URL=sqlite:///data/sentinel.db
SENTINEL_DATA_DIR=data
SENTINEL_ORIGIN=http://127.0.0.1:3000
SENTINEL_MODEL=yolo11n.pt
SENTINEL_DEVICE=cpu
SENTINEL_RETENTION_DAYS=7
SENTINEL_QUEUE=database
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_RTSP_HOSTS=
SENTINEL_RTSP_ALLOWED_IPS=
SENTINEL_ALLOW_LOOPBACK_CAMERA_FIXTURE=false
SENTINEL_STORAGE=local
SENTINEL_S3_ENDPOINT=
SENTINEL_S3_BUCKET=sentinel
SENTINEL_S3_REGION=us-east-1
SENTINEL_LEASE_SECONDS=120
SENTINEL_RETENTION_INTERVAL=3600
# For S3, provision AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the environment.
# Never commit those values. Endpoint must be reachable by worker and URL consumer.
